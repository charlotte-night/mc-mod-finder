# 复制为 .env 后按需填写。所有项都是可选的。

# ---------------------------------------------------------------- 监听

PORT=8765
# 127.0.0.1 只有本机能访问；改成 0.0.0.0 让局域网/容器外可访问
HOST=127.0.0.1

# 对外展示的地址（用隧道/域名时填上，界面页脚和 /api/health 会显示它）
PUBLIC_URL=

# ---------------------------------------------------------------- 反向代理

# 走 Cloudflare Tunnel / nginx 时设为 1，这样限流按真实访客 IP 计数而不是都算成 127.0.0.1。
# 只有当端口不直接对外暴露时才开启：客户端能直连时可以伪造 X-Forwarded-For。
TRUST_PROXY=0

# ---------------------------------------------------------------- 限流

# 公开部署务必保持开启：/api/speedtest 会让服务器真的下载文件，是带宽消耗口。
RATE_LIMIT=1
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
RATE_LIMIT_SPEEDTEST_PER_MINUTE=8
RATE_LIMIT_SPEEDTEST_BURST=3
SPEEDTEST_CONCURRENT=3

# ---------------------------------------------------------------- 数据源

# CurseForge 官方 API key（免费申请 https://console.curseforge.com/）。
# 不填也能跑：Modrinth 无需 key，CurseForge 会被自动禁用并在界面上标注原因。
# 注意：公开部署时这个 key 会承载所有访客的请求，请自行确认符合对方使用条款。
CURSEFORGE_API_KEY=

# 对外展示的 User-Agent。Modrinth 要求能标识调用方，公开部署请填真实联系方式。
CONTACT=https://github.com/your-name/mc-mod-finder

# ---------------------------------------------------------------- 测速

SPEEDTEST_MAX_BYTES=1048576
SPEEDTEST_TIMEOUT_MS=6000
# 同一 CDN 主机速率的缓存秒数
SPEEDTEST_HOST_TTL=600

# ---------------------------------------------------------------- 缓存

# 公开部署建议调大，减少对上游 API 的压力
SEARCH_CACHE_TTL=300
PROJECT_CACHE_TTL=1800
DISABLE_DISK_CACHE=0
