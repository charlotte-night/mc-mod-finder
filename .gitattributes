# Normalize line endings in the repository so Windows checkouts stop warning about CRLF
# and so the LF-only sources stay byte-identical for everyone.
* text=auto eol=lf

# Batch files must keep CRLF: cmd.exe mis-parses labels and goto in LF-only .bat files.
*.bat text eol=crlf

# Binary assets are never line-ending-converted.
*.png binary
*.ico binary
*.jpg binary
*.zip binary
*.jar binary
